# S.P.I.R.I.T. Mainframe Configuration
# Copy this file to .env and fill in your values

# Mainframe host (from your Quick3270 connection)
SPIRIT_HOST=IBMPRD.METRO-DADE.COM
SPIRIT_PORT=23

# Your mainframe login credentials
SPIRIT_USERNAME=your_username
SPIRIT_PASSWORD=your_password

# Application code to navigate to after login (C, P, F, G, B, W, N, K)
APP_CODE=C
